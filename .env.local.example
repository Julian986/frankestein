# Copiá este archivo a .env.local y completá los valores:
#   copy .env.local.example .env.local
#
# Sin estas variables, la app usa data/db.json (modo local).

NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# ── Setup Supabase (proyecto nuevo) ─────────────────────────────
# 1) Creá un proyecto en https://supabase.com (Free está bien)
# 2) Project Settings → API → copiá Project URL y anon public key
# 3) SQL Editor → New query → pegá TODO el contenido de:
#      supabase/migrations/001_init.sql
#    → Run (incluye GRANTs para la Data API)
#    Si ya corriste 001 sin grants y ves "permission denied":
#      ejecutá también supabase/migrations/004_api_grants.sql
#    (002/003 solo si el proyecto ya existía con schema viejo)
# 4) Guardá este archivo como .env.local con URL + anon key
# 5) Reiniciá: npm run dev
# 6) Probá: http://localhost:3000/api/health
#    Debe decir mode: "supabase" y ok: true
#
# ── Keep-alive (anti-pausa Free ~7 días) ────────────────────────
# En GitHub → Settings → Secrets and variables → Actions:
#   SUPABASE_URL      = la misma Project URL
#   SUPABASE_ANON_KEY = la misma anon key
# El workflow .github/workflows/supabase-keepalive.yml pega a la DB
# lunes y jueves. También se puede correr a mano desde Actions.
